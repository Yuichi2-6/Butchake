---
const services = [
  {
    img: '/images/service-wall.svg',
    title: '外壁塗装',
    text: '住宅・店舗の外壁を高耐候塗料で保護。色選びから足場・洗浄・下地補修まで自社職人が対応します。',
  },
  {
    img: '/images/service-roof.svg',
    title: '屋根塗装',
    text: '紫外線や雨風で劣化した屋根を再塗装し、遮熱・防水性能を回復。屋根材に合わせた塗料をご提案します。',
  },
  {
    img: '/images/service-waterproof.svg',
    title: '防水工事',
    text: 'ベランダ・屋上の防水層を補修・再施工し、雨漏りを未然に防止。ウレタン防水を中心に対応します。',
  },
  {
    img: '/images/service-parts.svg',
    title: '付帯部塗装',
    text: '雨樋・破風板・軒天など細部まで丁寧に塗装し、建物全体の美観と耐久性を底上げします。',
  },
];
---

<section id="services" class="services">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Services</p>
      <h2>サービス内容</h2>
      <p>戸建て・アパート・店舗まで、建物の外まわりをまるごとお任せいただけます。</p>
    </div>

    <div class="grid">
      {
        services.map((s) => (
          <div class="card">
            <img src={s.img} alt={s.title} width="480" height="320" loading="lazy" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding: 88px 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border: 1px solid var(--border-10);
  }

  .card h3 {
    margin-top: 20px;
    font-size: 17px;
    color: var(--primary);
  }

  .card p {
    margin-top: 12px;
    font-size: 13.5px;
    color: var(--ink-70);
  }

  @media (max-width: 900px) {
    .services {
      padding: 56px 20px;
    }

    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 540px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
