---
const steps = [
  { n: '01', title: 'お問い合わせ', text: '電話・フォームより現状のお悩みをお聞かせください。' },
  { n: '02', title: '現地調査・無料診断', text: '専門スタッフが訪問し、外壁・屋根の劣化状況を診断します。' },
  { n: '03', title: 'お見積もりのご提案', text: '診断結果をもとに、価格・工程を分かりやすくご説明します。' },
  { n: '04', title: '施工', text: '自社職人が丁寧に施工。工程ごとに写真で進捗をご報告します。' },
  { n: '05', title: '完了検査・保証書発行', text: '施工後に検査を実施し、保証書をお渡しして完了です。' },
];
---

<section id="flow" class="flow">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Flow</p>
      <h2>ご依頼から施工完了までの流れ</h2>
    </div>

    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <span class="num">{s.n}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .flow {
    padding: 88px 32px;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .steps li {
    display: flex;
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border-10);
  }

  .steps li:first-child {
    border-top: 1px solid var(--border-10);
  }

  .num {
    font-family: 'Zen Old Mincho', serif;
    font-size: 22px;
    color: var(--accent);
    min-width: 40px;
  }

  .steps h3 {
    font-size: 16px;
    color: var(--primary);
  }

  .steps p {
    margin-top: 8px;
    font-size: 13.5px;
    color: var(--ink-70);
  }

  @media (max-width: 900px) {
    .flow {
      padding: 56px 20px;
    }
  }
</style>
