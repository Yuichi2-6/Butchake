---
const rows = [
  { label: '会社名', value: '高田塗装（ダミー掲載）' },
  { label: '所在地', value: '東京都千代田区〇〇 1-2-3' },
  { label: '代表者', value: '高田 太郎' },
  { label: '設立', value: '2015年4月' },
  { label: '事業内容', value: '外壁塗装・屋根塗装・防水工事・付帯部塗装' },
  { label: '許可・資格', value: '建設業許可（塗装工事業） 一級塗装技能士 在籍' },
  { label: 'TEL', value: '0120-000-000（受付 9:00〜18:00）' },
];
---

<section id="company" class="company">
  <div class="container grid">
    <div class="section-head left">
      <p class="eyebrow">Company</p>
      <h2>会社概要</h2>
      <p>
        本サイトはインベストデザイン株式会社主催のセミナーにおいて、Claude
        Codeによるコーポレートサイト制作事例を紹介するために作成したダミーサイトです。
      </p>
    </div>

    <table class="info">
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th>{r.label}</th>
              <td>{r.value}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .company {
    padding: 88px 32px;
    background: var(--bg-alt);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 56px;
    align-items: start;
  }

  .section-head.left {
    text-align: left;
    margin-bottom: 0;
  }

  .info {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-base);
    border: 1px solid var(--border-10);
  }

  .info th,
  .info td {
    text-align: left;
    padding: 16px 20px;
    font-size: 14px;
    border-bottom: 1px solid var(--border-10);
  }

  .info tr:last-child th,
  .info tr:last-child td {
    border-bottom: none;
  }

  .info th {
    width: 32%;
    color: var(--primary);
    font-weight: 500;
    background: rgba(23, 50, 79, 0.04);
  }

  .info td {
    color: var(--ink-82);
  }

  @media (max-width: 900px) {
    .company {
      padding: 56px 20px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
