---
const strengths = [
  {
    n: '01',
    title: '職人直営で中間マージン無し',
    text: '営業を挟まず自社の職人が現地調査から施工まで対応。下請けに丸投げしないため、適正価格と品質を両立します。',
  },
  {
    n: '02',
    title: '施工後10年保証',
    text: '使用する塗料ごとに保証年数を明示し、施工後も定期点検を実施。塗り替え後の不具合に無償で対応します。',
  },
  {
    n: '03',
    title: '無料診断・無料見積もり',
    text: '外壁・屋根の劣化診断とお見積もりは無料。他社との比較も歓迎で、しつこい営業は一切行いません。',
  },
];
---

<section id="strengths" class="strengths">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Why Us</p>
      <h2>高田塗装が選ばれる理由</h2>
    </div>

    <div class="grid">
      {
        strengths.map((s) => (
          <div class="card">
            <span class="num">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .strengths {
    padding: 88px 32px;
    background: var(--bg-alt);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .card {
    background: var(--bg-base);
    padding: 36px 30px;
    border: 1px solid var(--border-10);
  }

  .num {
    font-family: 'Zen Old Mincho', serif;
    font-size: 28px;
    color: var(--accent);
  }

  .card h3 {
    margin-top: 16px;
    font-size: 18px;
    color: var(--primary);
  }

  .card p {
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink-70);
  }

  @media (max-width: 900px) {
    .strengths {
      padding: 56px 20px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
